{
  "name": "pubgmap-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "PUBG 六地图离线迫击炮测距桌面应用",
  "author": "Yungzzhh",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win dir --x64",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "com.yungzzhh.pubgmap",
    "productName": "PUBGRangefinder",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "publish": null
  }
}
